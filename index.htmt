<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Paradox Academy - Atif Ali</title><style>@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap');*{margin:0;padding:0;box-sizing:border-box;font-family:Poppins}body{background:#EEF4FF;display:flex;justify-content:center}.box{max-width:430px;width:100%;background:#EEF4FF;min-height:100vh}.nav{background:#fff;padding:14px 18px;display:flex;justify-content:space-between;box-shadow:0 2px 12px #0001;position:sticky;top:0;z-index:10}.logo{font-weight:700;color:#0A2540}.logo span{color:#0096FF}.hero{background:#fff;margin:12px;border-radius:20px;padding:24px;text-align:center;box-shadow:0 6px 24px #0001}.hero h1{color:#0A2540;font-size:24px}.hero h1 span{color:#0096FF}.fee-banner{background:linear-gradient(90deg,#0096FF,#635BFF);color:#fff;margin:12px 14px;border-radius:12px;padding:12px;text-align:center;font-weight:700;font-size:13px}.title{text-align:center;padding:12px}.title h2{color:#0A2540;font-size:20px}.course{background:#fff;margin:12px 14px;border-radius:16px;padding:16px;box-shadow:0 4px 16px #0001;border-left:5px solid #0096FF}.course h3{color:#0A2540;font-size:14px;display:flex;justify-content:space-between}.dur{background:#0A2540;color:#fff;padding:4px 10px;border-radius:8px;font-size:10px}.course p{color:#0096FF;font-size:12px;font-weight:700;margin:5px 0}.subj{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px}.subj span{background:#F0F6FF;border:1px solid #D5E5FF;padding:4px 8px;border-radius:6px;font-size:10px;font-weight:600}.form{background:#fff;margin:16px;border-radius:20px;padding:20px;box-shadow:0 8px 30px #0001}.form h2{text-align:center;color:#0A2540;font-size:18px}.sub{text-align:center;color:#6B7FA0;font-size:11px;margin-bottom:10px}.inp{width:100%;padding:12px;border:1.5px solid #D5DFEF;border-radius:10px;margin:6px 0;font-size:13px;background:#fff}.row{display:flex;gap:8px}.row .inp{f